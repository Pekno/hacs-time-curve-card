    },
    {
      "name": "trailing-newline-token-is-invalid",
      "curve": "19:00@100;21:00@70;23:00@10\n",
      "time": "22:00",
      "expected": "70",
      "canonical": "19:00@100;21:00@70",
      "max": "100",
      "note": "only ASCII space/tab are trimmed: a token ending in \\n is invalid (Python strip() without arguments and a regex ending in $ would accept it; use strip(' \\t'))"
    },
    {
      "name": "pct-with-leading-space-is-invalid",
      "curve": "19:00@100;21:00@70;22:00@ 10",
      "time": "21:30",
      "expected": "70",
      "canonical": "19:00@100;21:00@70",
      "max": "100",
      "note": "HA's int filter accepts ' 10' (3 chars, passes the length check): every digit must be checked against '0123456789' before | int"
    },
    {
      "name": "pct-with-plus-sign-is-invalid",
      "curve": "19:00@100;21:00@70;22:00@+10",
      "time": "21:30",
      "expected": "70",
      "canonical": "19:00@100;21:00@70",
      "max": "100",
      "note": "HA's int filter accepts '+10': check the digits before | int"
    },
    {
      "name": "malformed-decimal-point-is-invalid",
      "curve": "19:00@100;21:00@70;22:00@1.;23:00@.5;23:30@1.005",
      "time": "21:30",
      "expected": "70",
      "canonical": "19:00@100;21:00@70",
      "max": "100",
      "note": "a decimal part needs digits on both sides of '.', and at most 2 after it; HA's int / float filters would accept all three: validate the text before converting"
    },
    {
      "name": "pct-in-exponent-notation-is-invalid",
      "curve": "19:00@100;21:00@70;22:00@1e2",
      "time": "21:30",
      "expected": "70",
      "canonical": "19:00@100;21:00@70",
      "max": "100",
      "note": "'1e2' | int is 100 in HA (float fallback): check the digits before | int"
    },
    {
      "name": "pct-in-hex-notation-is-invalid",
      "curve": "19:00@100;21:00@70;22:00@0x1",
      "time": "21:30",
      "expected": "70",
      "canonical": "19:00@100;21:00@70",
      "max": "100",
      "note": "'0x1' | int(0) is the default 0, clamped to 1 if the token were kept: reject non-digits before converting"
    },
    {
      "name": "full-width-digits-do-not-override-a-point",
      "curve": "19:00@100;21:00@70;１９:００@５０",
      "time": "20:00",
      "expected": "85",
      "canonical": "19:00@100;21:00@70",
      "max": "100",
      "note": "full-width '１９:００@５０' is not 19:00@50: the token is invalid and must not win the duplicate-time rule (HA's int filter converts full-width digits)"
    },
    {
      "name": "arabic-indic-digits-are-invalid",
      "curve": "19:00@100;21:00@70;٢٢:٠٠@١٠",
      "time": "21:30",
      "expected": "70",
      "canonical": "19:00@100;21:00@70",
      "max": "100",
      "note": "Arabic-Indic digits: Python isdigit() / int() accept them, the TS grammar does not"
    },
    {
      "name": "one-digit-minute-is-invalid-even-with-one-digit-hour",
      "curve": "19:00@100;21:00@70;9:5@50",
      "time": "03:00",
      "expected": "70",
      "canonical": "19:00@100;21:00@70",
      "max": "100",
      "note": "minutes need exactly 2 digits: '9:5' is not 09:05"
    },
    {
      "name": "time-with-seconds-is-invalid",
      "curve": "19:00@100;21:00@70;22:00:00@10",
