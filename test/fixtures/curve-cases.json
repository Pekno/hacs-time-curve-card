    },
    {
      "name": "invalid-value-format-ignored",
      "curve": "19:00@100;20:30@+5;22:00@50%;22:30@;@50;23:00@abc;21:00@70",
      "time": "20:00",
      "expected": "85",
      "canonical": "19:00@100;21:00@70",
      "max": "100",
      "note": "plus sign, %, missing value, missing time and letters are invalid (a leading '-' and a decimal part are valid since v2: see the v2-* cases)"
    },
    {
      "name": "five-digit-value-is-invalid-not-clamped",
      "curve": "19:00@50;21:00@10000;23:00@10",
      "time": "21:00",
      "expected": "30",
      "canonical": "19:00@50;23:00@10",
      "max": "50",
      "note": "10000 has 5 digits (v2 allows 1-4): the token is dropped, NOT clamped to 100; v = 50 + (-40 * 120) / 240"
    },
    {
      "name": "invalid-internal-spaces",
      "curve": "19:00@100;20:00 @50;20:30@ 50;21 :00@50;21:00@70",
      "time": "20:00",
      "expected": "85",
      "canonical": "19:00@100;21:00@70",
      "max": "100"
    },
    {
      "name": "non-ascii-digits-are-invalid",
      "curve": "19:00@100;21:00@70;２３:００@１０",
      "time": "22:00",
      "expected": "70",
      "canonical": "19:00@100;21:00@70",
      "max": "100",
