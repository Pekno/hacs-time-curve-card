{
  "description": "Single source of truth for curve semantics; run by test/curve.test.ts AND test/jinja/test_sensor.py",
  "$comment": "v2: expected / canonical / max are strings in the canonical value format ('25', '19.5', '-2.05') or null (invalid curve). A case may carry range [minCenti, maxCenti] and step (centi-units, hundredths of a unit); the defaults are the brightness range [100, 10000] and step 100, so every v1 case keeps its meaning. The Jinja harness runs a case against a package only when the case's range and step equal the package's.",
  "cases": [
    {
      "name": "mid-segment-simple",
      "curve": "19:00@100;21:00@70",
      "time": "20:00",
      "expected": "85",
      "canonical": "19:00@100;21:00@70",
      "max": "100",
      "note": "linear midpoint"
    },
    {
      "name": "before-first-point-holds-first-value",
      "curve": "19:00@100;21:00@70",
      "time": "18:00",
      "expected": "100",
      "canonical": "19:00@100;21:00@70",
      "max": "100"
    },
    {
      "name": "after-last-point-holds-last-value-at-03-00",
      "curve": "19:00@100;21:00@70",
      "time": "03:00",
      "expected": "70",
      "canonical": "19:00@100;21:00@70",
      "max": "100",
      "note": "3 a.m. (after the last point) stays at the dim value"
    },
    {
      "name": "noon-is-the-start-of-the-curve-day",
      "curve": "19:00@100;21:00@70",
      "time": "12:00",
      "expected": "100",
      "canonical": "19:00@100;21:00@70",
      "max": "100",
      "note": "sort key 0: before the first point"
    },
    {
      "name": "11-59-is-the-end-of-the-curve-day",
      "curve": "19:00@100;21:00@70",
      "time": "11:59",
      "expected": "70",
      "canonical": "19:00@100;21:00@70",
      "max": "100",
      "note": "sort key 1439: after the last point"
    },
    {
      "name": "exactly-on-first-point",
      "curve": "19:00@100;21:00@70;23:00@10",
      "time": "19:00",
      "expected": "100",
      "canonical": "19:00@100;21:00@70;23:00@10",
      "max": "100",
      "note": "k == k_0 -> v_0"
    },
    {
      "name": "exactly-on-interior-point",
      "curve": "19:00@100;21:00@70;23:00@10",
      "time": "21:00",
      "expected": "70",
      "canonical": "19:00@100;21:00@70;23:00@10",
      "max": "100",
      "note": "k == k_1: start of the second segment, value of the point itself"
    },
    {
      "name": "exactly-on-last-point",
      "curve": "19:00@100;21:00@70;23:00@10",
      "time": "23:00",
      "expected": "10",
      "canonical": "19:00@100;21:00@70;23:00@10",
      "max": "100",
      "note": "k == k_last -> v_last"
    },
    {
      "name": "mid-segment-in-second-segment",
      "curve": "19:00@100;21:00@70;23:00@10",
      "time": "22:30",
      "expected": "25",
      "canonical": "19:00@100;21:00@70;23:00@10",
      "max": "100",
      "note": "v = 70 + (-60 * 90) / 120 = 25"
    },
    {
      "name": "default-curve-mid-segment",
      "curve": "19:00@100;21:00@70;22:30@30;23:30@12",
      "time": "21:45",
      "expected": "50",
      "canonical": "19:00@100;21:00@70;22:30@30;23:30@12",
      "max": "100",
      "note": "DEFAULT_CURVE, midpoint of 21:00@70 -> 22:30@30"
    },
    {
      "name": "default-curve-last-segment",
      "curve": "19:00@100;21:00@70;22:30@30;23:30@12",
      "time": "23:00",
      "expected": "21",
      "canonical": "19:00@100;21:00@70;22:30@30;23:30@12",
      "max": "100",
      "note": "v = 30 + (-18 * 30) / 60 = 21"
    },
    {
      "name": "plateau-segment",
      "curve": "19:00@50;21:00@50",
      "time": "20:00",
      "expected": "50",
      "canonical": "19:00@50;21:00@50",
      "max": "50"
    },
    {
      "name": "crossing-midnight-mid-segment",
      "curve": "23:00@40;01:00@10",
      "time": "00:00",
      "expected": "25",
      "canonical": "23:00@40;01:00@10",
      "max": "40",
      "note": "sort keys 660, 720, 780: midnight is the middle of the segment"
    },
    {
      "name": "crossing-midnight-before-first-point",
      "curve": "23:00@40;01:00@10",
      "time": "13:00",
      "expected": "40",
      "canonical": "23:00@40;01:00@10",
      "max": "40",
      "note": "early afternoon (k = 60) is before the first point"
    },
    {
      "name": "crossing-midnight-after-last-point",
      "curve": "23:00@40;01:00@10",
      "time": "02:00",
      "expected": "10",
      "canonical": "23:00@40;01:00@10",
      "max": "40"
    },
    {
      "name": "midnight-exact-point",
      "curve": "23:00@40;00:00@20;01:00@10",
      "time": "00:00",
      "expected": "20",
      "canonical": "23:00@40;00:00@20;01:00@10",
      "max": "40",
      "note": "a point at 00:00 (k = 720) is hit exactly"
    },
    {
      "name": "midnight-point-segment-before",
      "curve": "23:00@40;00:00@20;01:00@10",
      "time": "23:30",
      "expected": "30",
      "canonical": "23:00@40;00:00@20;01:00@10",
      "max": "40"
    },
    {
      "name": "midnight-point-segment-after",
      "curve": "23:00@40;00:00@20;01:00@10",
      "time": "00:30",
      "expected": "15",
      "canonical": "23:00@40;00:00@20;01:00@10",
      "max": "40"
    },
    {
      "name": "adjacent-minutes-across-midnight",
      "curve": "23:59@40;00:00@10",
      "time": "00:00",
      "expected": "10",
      "canonical": "23:59@40;00:00@10",
      "max": "40",
      "note": "keys 719 and 720 are consecutive; 00:00 is the last point"
    },
    {
      "name": "full-day-curve-mid-segment",
      "curve": "12:00@100;11:59@1",
      "time": "00:00",
      "expected": "50",
      "canonical": "12:00@100;11:59@1",
      "max": "100",
      "note": "v = 100 + (-99 * 720) / 1439 = 50.47 -> 50"
    },
    {
      "name": "full-day-curve-exactly-on-noon-point",
      "curve": "12:00@100;11:59@1",
      "time": "12:00",
      "expected": "100",
      "canonical": "12:00@100;11:59@1",
      "max": "100"
    },
    {
      "name": "full-day-curve-exactly-on-11-59-point",
      "curve": "12:00@100;11:59@1",
      "time": "11:59",
      "expected": "1",
      "canonical": "12:00@100;11:59@1",
      "max": "100"
    },
    {
      "name": "unsorted-day-boundary-points",
      "curve": "11:59@60;12:00@50",
      "time": "00:00",
      "expected": "55",
      "canonical": "12:00@50;11:59@60",
      "max": "60",
      "note": "12:00 sorts first, 11:59 last; v = 50 + (10 * 720) / 1439 = 55.003 -> 55"
    },
    {
      "name": "unsorted-input-is-sorted",
      "curve": "23:30@12;19:00@100;22:30@30;21:00@70",
      "time": "21:45",
      "expected": "50",
      "canonical": "19:00@100;21:00@70;22:30@30;23:30@12",
      "max": "100"
    },
    {
      "name": "unsorted-morning-point-sorts-after-late-night",
      "curve": "11:00@10;23:00@40",
      "time": "05:00",
      "expected": "25",
      "canonical": "23:00@40;11:00@10",
      "max": "40",
      "note": "noon pivot: 11:00 (k = 1380) comes after 23:00 (k = 660); v = 40 + (-30 * 360) / 720"
    },
    {
      "name": "twelve-point-curve-crossing-midnight",
      "curve": "17:00@100;18:00@95;19:00@90;20:00@80;21:00@70;22:00@55;23:00@40;00:00@30;01:00@22;02:00@16;03:00@12;04:00@10",
      "time": "00:30",
      "expected": "26",
      "canonical": "17:00@100;18:00@95;19:00@90;20:00@80;21:00@70;22:00@55;23:00@40;00:00@30;01:00@22;02:00@16;03:00@12;04:00@10",
      "max": "100",
      "note": "max_points default; v = 30 + (-8 * 30) / 60 = 26"
    },
    {
      "name": "twelve-point-curve-last-segment",
      "curve": "17:00@100;18:00@95;19:00@90;20:00@80;21:00@70;22:00@55;23:00@40;00:00@30;01:00@22;02:00@16;03:00@12;04:00@10",
      "time": "03:30",
      "expected": "11",
      "canonical": "17:00@100;18:00@95;19:00@90;20:00@80;21:00@70;22:00@55;23:00@40;00:00@30;01:00@22;02:00@16;03:00@12;04:00@10",
      "max": "100"
    },
    {
      "name": "rounding-half-up-on-an-ascending-segment",
      "curve": "20:00@10;22:00@13",
      "time": "20:20",
      "expected": "11",
      "canonical": "20:00@10;22:00@13",
      "max": "13",
      "note": "v = 10 + (3 * 20) / 120 = 10.5 -> 11"
    },
    {
      "name": "rounding-half-up-on-a-descending-segment",
      "curve": "20:00@13;22:00@10",
      "time": "21:40",
      "expected": "11",
      "canonical": "20:00@13;22:00@10",
      "max": "13",
      "note": "v = 13 + (-3 * 100) / 120 = 10.5 -> 11"
    },
    {
      "name": "rounding-below-half-rounds-down",
      "curve": "19:00@100;21:00@70",
      "time": "20:59",
      "expected": "70",
      "canonical": "19:00@100;21:00@70",
      "max": "100",
      "note": "v = 100 + (-30 * 119) / 120 = 70.25 -> 70"
    },
    {
      "name": "rounding-above-half-rounds-up",
      "curve": "19:00@100;21:00@70",
      "time": "19:01",
      "expected": "100",
      "canonical": "19:00@100;21:00@70",
      "max": "100",
      "note": "v = 100 + (-30 * 1) / 120 = 99.75 -> 100"
    },
    {
      "name": "operation-order-slope-first-would-round-down",
      "curve": "20:00@30;20:14@1",
      "time": "20:07",
      "expected": "16",
      "canonical": "20:00@30;20:14@1",
      "max": "30",
      "note": "v = 30 + (-29 * 7) / 14 = 15.5 -> 16; computing (b-a)/(kb-ka) first gives 15.4999 -> 15"
    },
    {
      "name": "operation-order-ratio-first-would-round-down",
      "curve": "20:00@100;20:20@10",
      "time": "20:11",
      "expected": "51",
      "canonical": "20:00@100;20:20@10",
      "max": "100",
      "note": "v = 100 + (-90 * 11) / 20 = 50.5 -> 51; computing (k-ka)/(kb-ka) first gives 50.4999 -> 50"
    },
    {
      "name": "operation-order-slope-first-across-midnight",
      "curve": "23:00@70;00:30@1",
      "time": "00:15",
      "expected": "13",
      "canonical": "23:00@70;00:30@1",
      "max": "70",
      "note": "v = 70 + (-69 * 75) / 90 = 12.5 exactly -> 13; slope-first 70 + (-69 / 90) * 75 = 12.499999999999993 -> 12. Segment crosses midnight (keys 660 -> 750, k = 735): second guard so removing one operation-order case does not hide a regression"
    },
    {
      "name": "operation-order-ratio-first-across-midnight",
      "curve": "23:00@100;01:00@10",
      "time": "00:02",
      "expected": "54",
      "canonical": "23:00@100;01:00@10",
      "max": "100",
      "note": "v = 100 + (-90 * 62) / 120 = 53.5 exactly -> 54; ratio-first 100 + -90 * (62 / 120) = 53.49999999999999 -> 53. Segment crosses midnight (keys 660 -> 780, k = 722): second guard so removing one operation-order case does not hide a regression"
    },
    {
      "name": "clamp-pct-below-1-and-above-100",
      "curve": "19:00@0;21:00@150",
      "time": "20:00",
      "expected": "51",
      "canonical": "19:00@1;21:00@100",
      "max": "100",
      "note": "0 -> 1, 150 -> 100; v = 1 + (99 * 60) / 120 = 50.5 -> 51"
    },
    {
      "name": "clamp-three-digit-pct",
      "curve": "19:00@000;21:00@999",
      "time": "19:00",
      "expected": "1",
      "canonical": "19:00@1;21:00@100",
      "max": "100",
      "note": "000 -> 1, 999 -> 100 (3 digits are still a valid token)"
    },
    {
      "name": "zero-padded-pct-serializes-unpadded",
      "curve": "19:00@007;21:00@070",
      "time": "20:00",
      "expected": "39",
      "canonical": "19:00@7;21:00@70",
      "max": "70",
      "note": "v = 7 + (63 * 60) / 120 = 38.5 -> 39; leading zeros are VALID ('070' is 70 in base 10): the Jinja digit check must not reject them"
    },
    {
      "name": "one-digit-hour-serializes-zero-padded",
      "curve": "9:30@5;19:00@100",
      "time": "20:00",
      "expected": "93",
      "canonical": "19:00@100;09:30@5",
      "max": "100",
      "note": "keys 420 (19:00) and 1290 (09:30); v = 100 + (-95 * 60) / 870 = 93.45 -> 93"
    },
    {
      "name": "duplicate-time-last-wins",
      "curve": "19:00@100;21:00@70;19:00@50",
      "time": "20:00",
      "expected": "60",
      "canonical": "19:00@50;21:00@70",
      "max": "70"
    },
    {
      "name": "duplicate-time-one-digit-hour-equals-two-digit",
      "curve": "9:05@10;12:00@30;09:05@20",
      "time": "09:05",
      "expected": "20",
      "canonical": "12:00@30;09:05@20",
      "max": "30",
      "note": "9:05 and 09:05 are the same minute; the later token wins"
    },
    {
      "name": "invalid-duplicate-does-not-override",
      "curve": "19:00@100;21:00@70;19:00@abc",
      "time": "20:00",
      "expected": "85",
      "canonical": "19:00@100;21:00@70",
      "max": "100",
      "note": "only VALID occurrences take part in last-wins"
    },
    {
      "name": "duplicates-collapse-below-minimum",
      "curve": "19:00@100;19:00@50",
      "time": "20:00",
      "expected": null,
      "canonical": null,
      "max": null,
      "note": "two tokens, one distinct time -> 1 point -> invalid"
    },
    {
      "name": "whitespace-around-tokens",
      "curve": "  19:00@100 ;\t21:00@70\t; ",
      "time": "20:00",
      "expected": "85",
      "canonical": "19:00@100;21:00@70",
      "max": "100",
      "note": "ASCII spaces and tabs are trimmed; the trailing blank token is ignored"
    },
    {
      "name": "empty-tokens-and-trailing-separator",
      "curve": ";19:00@100;;21:00@70;",
      "time": "20:00",
      "expected": "85",
      "canonical": "19:00@100;21:00@70",
      "max": "100"
    },
    {
      "name": "spec-section-3-example",
      "curve": " 9:05@0 ; 23:00@40;09:05@150",
      "time": "00:00",
      "expected": "46",
      "canonical": "23:00@40;09:05@100",
      "max": "100",
      "note": "trim + 1-digit hour + last-wins + clamp + sort; v = 40 + (60 * 60) / 605 = 45.95 -> 46"
    },
    {
      "name": "invalid-tokens-garbage-ignored",
      "curve": "19:00@100;bogus;hello world;21:00@70",
